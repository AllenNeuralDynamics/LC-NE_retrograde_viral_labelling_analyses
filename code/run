#!/usr/bin/env bash
set -euxo pipefail
cd /code
# This is the master script for the capsule. When you click "Reproducible Run", the code in this file will execute.

# Name of the standalone soma-table asset that build_soma_table_asset.py writes to
# results/$ASSET_NAME/. Dated by default (AIND convention) so each run mints a distinct asset;
# exported so the --metadata (first) and --csv (last) invocations agree on the folder. Override
# by setting ASSET_NAME before the run.
export ASSET_NAME="${ASSET_NAME:-LC-NE_retrograde_soma_table_$(date -u +%Y-%m-%d_%H-%M-%S)}"

# Write the soma-table asset's AIND metadata (data_description.json + processing.json + README)
# into results/$ASSET_NAME/ FIRST, before the ~1.5h notebook run. The metadata does not read any
# notebook output, so a missing "Code Ocean API Credentials" secret surfaces here in seconds
# (processing.json skipped with a warning) instead of after the full run. The CSV is copied in at
# the end by the --csv call below, once notebook 1 has produced it.
python build_soma_table_asset.py --metadata

jupyter nbconvert \
	--to 'html' \
	--ExecutePreprocessor.timeout=-1 \
	--FilesWriter.build_directory=../results \
	--execute notebooks/FINAL_1_csv_compile_df_manually_proofed_Ai65.ipynb

jupyter nbconvert \
	--to 'html' \
	--ExecutePreprocessor.timeout=-1 \
	--FilesWriter.build_directory=../results \
	--execute notebooks/FINAL_2_manually_proofed_Ai65_plot_counts_densities.ipynb

jupyter nbconvert \
	--to 'html' \
	--ExecutePreprocessor.timeout=-1 \
	--FilesWriter.build_directory=../results \
	--execute notebooks/FINAL_3_manually_proofed_Ai65_3Dplot_somata_positions_byROI.ipynb

jupyter nbconvert \
	--to 'html' \
	--ExecutePreprocessor.timeout=-1 \
	--FilesWriter.build_directory=../results \
	--execute notebooks/FINAL_4_manually_proofed_Ai65_stats_regression.ipynb

jupyter nbconvert \
	--to 'html' \
	--ExecutePreprocessor.timeout=-1 \
	--FilesWriter.build_directory=../results \
	--execute notebooks/FINAL_5_manually_proofed_AI65_meshes_plots_H2B-LC.ipynb

jupyter nbconvert \
	--to 'html' \
	--ExecutePreprocessor.timeout=-1 \
	--FilesWriter.build_directory=../results \
	--execute notebooks/H2B-LC_meshes_MAPseq_data.ipynb

# Organize figures: copy the published manuscript panels into results/paper_figures/ (named by
# panel) and everything else into results/other_figures/, leaving results/plots/ as the raw output.
python organize_paper_figures.py

# Copy notebook 1's compiled soma table into the asset folder results/$ASSET_NAME/ (its metadata
# + README were written up front). Save that subfolder as a Code Ocean data asset for downstream
# consumers.
python build_soma_table_asset.py --csv
